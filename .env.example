# Written by `shopify app env pull`
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions

# Optional. Without it, every offer uses the deterministic fallback.
OPENAI_API_KEY=

# Store used by `npm run seed` and the app URL publisher
SHOP=your-store.myshopify.com
